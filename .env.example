# Path to SQLite database file (relative to project root)
DB_PATH=./data/jobs.sqlite

# How often to run scrapers (minutes). 0 disables cron (manual only).
SCRAPE_INTERVAL_MINUTES=30

# Staleness thresholds. A listing is marked "stale" when:
#   - it hasn't been confirmed by a scrape in the last X days, OR
#   - its posted_at is older than Y days.
# A group is stale only when ALL its listings are stale. Stale groups are
# hidden by default in the UI; toggle "pokaż archiwum" to show them.
STALE_LAST_SEEN_DAYS=7
STALE_POSTED_DAYS=60

# Jooble API key (optional). Register at https://jooble.org/api/about — free tier available.
# Without this key the Jooble scraper is silently skipped.
JOOBLE_API_KEY=

# Email notifications (optional). Leave empty to disable.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
